# MESA Law - Local Development Environment Variables

# App settings
MESA_LAW_ENVIRONMENT=development
MESA_LAW_SECRET_KEY=replace_with_at_least_32_random_characters
MESA_LAW_API_PORT=8001
MESA_LAW_TEST_AUTH_ENABLED=false

# Postgres settings
POSTGRES_USER=mesa
POSTGRES_PASSWORD=replace_with_a_random_postgres_admin_password
POSTGRES_DB=mesa_law
KEYCLOAK_DB=keycloak
MESA_LAW_DATABASE_URL=postgresql+psycopg://mesa_law_app:replace_with_a_random_app_password@localhost:5432/mesa_law
MESA_LAW_MIGRATOR_DATABASE_URL=postgresql+psycopg://mesa:replace_with_a_random_postgres_admin_password@localhost:5432/mesa_law
MESA_LAW_APP_DB_PASSWORD=replace_with_a_random_app_password
MESA_LAW_WORKER_DB_PASSWORD=replace_with_a_random_worker_password
MESA_LAW_MIGRATOR_DB_PASSWORD=replace_with_a_random_migrator_password
MESA_LAW_DATABASE_POOL_SIZE=5
MESA_LAW_DATABASE_MAX_OVERFLOW=5
MESA_LAW_SQL_ECHO=false

# Intelligence Adapter settings
# Options: mock, postgres_lexical, mesa_v4
MESA_LAW_INTELLIGENCE_ADAPTER=mock
MESA_LAW_MESA_API_KEY=replace_with_a_provisioned_mesa_v4_api_key
MESA_LAW_MESA_BACKEND_URL=http://localhost:8000

# MinIO / S3 settings
MESA_LAW_STORAGE_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=replace_with_a_random_minio_user
MINIO_ROOT_PASSWORD=replace_with_a_random_minio_password
MESA_LAW_STORAGE_ACCESS_KEY=replace_with_a_random_minio_user
MESA_LAW_STORAGE_SECRET_KEY=replace_with_a_random_minio_password
MESA_LAW_STORAGE_BUCKET=mesa-law-docs

# Worker & Extraction Settings
MESA_LAW_EXTRACTION_ADAPTER=heuristic
MESA_LAW_CLAMAV_REQUIRED=true
MESA_LAW_WORKER_CONCURRENCY=1
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Observability
MESA_LAW_OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_ADMIN_PASSWORD=replace_with_a_random_grafana_password

# Frontend Settings
NEXT_PUBLIC_MESA_LAW_API_BASE_URL=http://localhost:8001
MESA_LAW_BACKEND_URL=http://localhost:8001
NEXTAUTH_SECRET=replace_with_at_least_32_random_characters

# Keycloak Auth Settings
KEYCLOAK_CLIENT_ID=mesa-client
KEYCLOAK_CLIENT_SECRET=replace_with_at_least_32_random_characters
KEYCLOAK_ADMIN=replace_with_a_non_default_admin_name
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_random_keycloak_admin_password
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8080/realms/mesa_law
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/mesa_law/protocol/openid-connect/certs
