{
  "realm": "mesa_law",
  "enabled": true,
  "clients": [
    {
      "clientId": "mesa-client",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocolMappers": [
        {
          "name": "audience-mapping",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mesa-client",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "FIRM_ADMIN" },
      { "name": "ATTORNEY" },
      { "name": "PARALEGAL" },
      { "name": "READ_ONLY" },
      { "name": "AUDITOR" },
      { "name": "SUPPORT_TEMPORARY" }
    ]
  }
}
