{
  "realm": "mesa_law",
  "enabled": true,
  "clients": [
    {
      "clientId": "mesa-client",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "FIRM_ADMIN" },
      { "name": "ATTORNEY" },
      { "name": "PARALEGAL" },
      { "name": "READ_ONLY" },
      { "name": "AUDITOR" },
      { "name": "SUPPORT_TEMPORARY" }
    ]
  }
}
